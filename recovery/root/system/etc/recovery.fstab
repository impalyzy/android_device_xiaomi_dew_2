# Logical / Dynamic Partitions (Virtual A/B)
system          /system         erofs   ro              wait,logical,first_stage_mount,slotselect
system_ext      /system_ext     erofs   ro              wait,logical,first_stage_mount,slotselect
vendor          /vendor         erofs   ro              wait,logical,first_stage_mount,slotselect
product         /product        erofs   ro              wait,logical,first_stage_mount,slotselect
vendor_dlkm     /vendor_dlkm    erofs   ro              wait,logical,first_stage_mount,slotselect
odm_dlkm        /odm_dlkm       erofs   ro              wait,logical,first_stage_mount,slotselect
system_dlkm     /system_dlkm    erofs   ro              wait,logical,first_stage_mount,slotselect

# Data & Metadata Mounts (Android 16 / F2FS Encryption)
/dev/block/by-name/metadata     /metadata       f2fs    noatime,nosuid,nodev,discard    wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata     /data           f2fs    noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt,gc_merge,atgc,age_extent_cache wait,check,formattable,quota,latemount,resize,readahead_size_kb=512,reservedsize=128m,checkpoint=fs,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption

# Core Flashing & Backup Partitions (OrangeFox Flags Enabled)
/dev/block/by-name/boot         /boot           emmc    defaults                        flags=display="Boot";backup=1;flashimg=1;slotselect
/dev/block/by-name/vendor_boot  /vendor_boot    emmc    defaults                        flags=display="Vendor Boot";backup=1;flashimg=1;slotselect
/dev/block/by-name/init_boot    /init_boot      emmc    defaults                        flags=display="Init Boot";backup=1;flashimg=1;slotselect
/dev/block/by-name/dtbo         /dtbo           emmc    defaults                        flags=display="DTBO";backup=1;flashimg=1;slotselect
/dev/block/by-name/vbmeta       /vbmeta         emmc    defaults                        flags=display="VBMeta";backup=1;flashimg=1;slotselect
/dev/block/by-name/vbmeta_system /vbmeta_system emmc    defaults                        flags=display="VBMeta System";backup=1;flashimg=1;slotselect
/dev/block/by-name/logo         /logo           emmc    defaults                        flags=display="Logo";backup=1;flashimg=1

# NVRAM / Security Backups (IMEI & Calibration Protection)
/dev/block/by-name/nvram        /nvram          emmc    defaults                        flags=display="NVRAM";backup=1;subpartitionof=/nvdata
/dev/block/by-name/nvdata       /nvdata         ext4    noatime,nosuid,nodev            flags=display="NVData";backup=1
/dev/block/by-name/nvcfg        /nvcfg          ext4    noatime,nosuid,nodev            flags=display="NVCfg";backup=1;subpartitionof=/nvdata
/dev/block/by-name/protect1     /protect_f      ext4    noatime,nosuid,nodev            flags=display="Protect_F";backup=1;subpartitionof=/nvdata
/dev/block/by-name/protect2     /protect_s      ext4    noatime,nosuid,nodev            flags=display="Protect_S";backup=1;subpartitionof=/nvdata
/dev/block/by-name/proinfo      /proinfo        emmc    defaults                        flags=display="Proinfo";backup=1;subpartitionof=/nvdata
/dev/block/by-name/persist      /persist        ext4    noatime,nosuid,nodev            flags=display="Persist";backup=1

# External Storage Mounts
/devices/platform/11240000.mmc* auto            auto    defaults                        voldmanaged=sdcard1:auto
/devices/platform/mt_usb*       auto            vfat    defaults                        voldmanaged=usbotg:auto
